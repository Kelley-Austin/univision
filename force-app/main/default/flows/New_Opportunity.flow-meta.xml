<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>Guided 3-screen flow for reps to create a new Opportunity. Walks through account/buy type, opportunity details, and campaign timeline. Defaults StageName to Prospecting.</description>
    <interviewLabel>New Opportunity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>New Opportunity</label>
    <processType>Flow</processType>

    <dynamicChoiceSets>
        <name>dcs_MediaType</name>
        <dataType>Picklist</dataType>
        <displayField>label</displayField>
        <picklistObject>Opportunity</picklistObject>
        <picklistField>Media_Type__c</picklistField>
    </dynamicChoiceSets>

    <dynamicChoiceSets>
        <name>dcs_LeadSource</name>
        <dataType>Picklist</dataType>
        <displayField>label</displayField>
        <picklistObject>Opportunity</picklistObject>
        <picklistField>LeadSource</picklistField>
    </dynamicChoiceSets>

    <choices>
        <name>choice_DirectBuy</name>
        <choiceText>TV - Linear (owned-and-operated)</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>TV Linear</stringValue>
        </value>
    </choices>

    <choices>
        <name>choice_AgencyBuy</name>
        <choiceText>Digital (Operative-sourced)</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Digital</stringValue>
        </value>
    </choices>

    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>screen_AccountType</targetReference>
        </connector>
    </start>

    <screens>
        <name>screen_AccountType</name>
        <label>Account &amp; Buy Type</label>
        <locationX>264</locationX>
        <locationY>158</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>screen_OpportunityDetails</targetReference>
        </connector>

        <fields>
            <name>display_Step1Header</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Step 1 of 3 - Account &amp;amp; Buy Type&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Select the advertiser account and how this buy is placed.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>

        <fields>
            <name>input_AccountId</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>varAccountId</elementReference>
            </defaultValue>
            <fieldText>Advertiser Account ID</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>

        <fields>
            <name>input_BuyType</name>
            <choiceReferences>choice_DirectBuy</choiceReferences>
            <choiceReferences>choice_AgencyBuy</choiceReferences>
            <dataType>String</dataType>
            <defaultSelectedChoiceReference>choice_DirectBuy</defaultSelectedChoiceReference>
            <fieldText>Buy Type</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>

        <fields>
            <name>input_AgencyAccountId</name>
            <dataType>String</dataType>
            <fieldText>Agency Account ID</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>input_BuyType</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>Digital</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
    </screens>

    <screens>
        <name>screen_OpportunityDetails</name>
        <label>Opportunity Details</label>
        <locationX>264</locationX>
        <locationY>398</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>screen_Timeline</targetReference>
        </connector>

        <fields>
            <name>display_Step2Header</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Step 2 of 3 - Opportunity Details&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Describe what you&apos;re selling and how this opportunity was identified.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>

        <fields>
            <name>input_OpportunityName</name>
            <dataType>String</dataType>
            <fieldText>Opportunity Name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>

        <fields>
            <name>input_MediaType</name>
            <choiceReferences>dcs_MediaType</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Media Type</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>

        <fields>
            <name>input_Market</name>
            <dataType>String</dataType>
            <fieldText>Market / DMA</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>

        <fields>
            <name>input_PrimaryContactId</name>
            <dataType>String</dataType>
            <fieldText>Primary Contact ID</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>

        <fields>
            <name>input_EstimatedRevenue</name>
            <dataType>Currency</dataType>
            <fieldText>Estimated Revenue</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <scale>2</scale>
        </fields>

        <fields>
            <name>input_LeadSource</name>
            <choiceReferences>dcs_LeadSource</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Lead Source</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>false</isRequired>
        </fields>

        <fields>
            <name>input_Description</name>
            <dataType>String</dataType>
            <fieldText>Description / Notes</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
    </screens>

    <screens>
        <name>screen_Timeline</name>
        <label>Campaign Timeline</label>
        <locationX>264</locationX>
        <locationY>638</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>create_Opportunity</targetReference>
        </connector>

        <fields>
            <name>display_Step3Header</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Step 3 of 3 - Campaign Timeline&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Set the expected close date and campaign flight dates.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>

        <fields>
            <name>input_CloseDate</name>
            <dataType>Date</dataType>
            <fieldText>Expected Close Date</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>

        <fields>
            <name>input_StartDate</name>
            <dataType>Date</dataType>
            <fieldText>Campaign Start Date</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>

        <fields>
            <name>input_EndDate</name>
            <dataType>Date</dataType>
            <fieldText>Campaign End Date</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>

        <fields>
            <name>input_Competition</name>
            <dataType>String</dataType>
            <fieldText>Competition</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>

        <fields>
            <name>input_NextStep</name>
            <dataType>String</dataType>
            <fieldText>Next Step</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
    </screens>

    <screens>
        <name>screen_Confirmation</name>
        <label>Opportunity Created</label>
        <locationX>264</locationX>
        <locationY>1118</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>display_ConfirmationMsg</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Opportunity created successfully.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Your opportunity has been created with a stage of &lt;em&gt;Prospecting&lt;/em&gt;.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
    </screens>

    <recordCreates>
        <name>create_Opportunity</name>
        <label>Create Opportunity</label>
        <locationX>264</locationX>
        <locationY>878</locationY>
        <assignRecordIdToReference>varCreatedOpportunityId</assignRecordIdToReference>
        <connector>
            <targetReference>screen_Confirmation</targetReference>
        </connector>

        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>input_OpportunityName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <elementReference>input_AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Agency_Account__c</field>
            <value>
                <elementReference>input_AgencyAccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Primary_Contact__c</field>
            <value>
                <elementReference>input_PrimaryContactId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StageName</field>
            <value>
                <stringValue>Prospecting</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Media_Type__c</field>
            <value>
                <elementReference>input_MediaType</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Market__c</field>
            <value>
                <elementReference>input_Market</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Amount</field>
            <value>
                <elementReference>input_EstimatedRevenue</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LeadSource</field>
            <value>
                <elementReference>input_LeadSource</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>input_Description</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CloseDate</field>
            <value>
                <elementReference>input_CloseDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Start_Date__c</field>
            <value>
                <elementReference>input_StartDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>End_Date__c</field>
            <value>
                <elementReference>input_EndDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Competition__c</field>
            <value>
                <elementReference>input_Competition</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>NextStep</field>
            <value>
                <elementReference>input_NextStep</elementReference>
            </value>
        </inputAssignments>

        <object>Opportunity</object>
    </recordCreates>

    <status>Active</status>

    <variables>
        <name>varAccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <variables>
        <name>varCreatedOpportunityId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>