<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>Creates an Advertising Contract from an approved Advertising Opportunity. Guards against non-Approved status and duplicate active contracts.</description>
    <interviewLabel>Promote Opportunity to Contract {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Promote Opportunity to Contract</label>
    <processType>Flow</processType>
    <runInMode>DefaultMode</runInMode>

    <choices>
        <name>choiceStandard30</name>
        <choiceText>Standard 30-Day Notice</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Standard 30-Day</stringValue></value>
    </choices>
    <choices>
        <name>choiceStandard60</name>
        <choiceText>Standard 60-Day Notice</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Standard 60-Day</stringValue></value>
    </choices>
    <choices>
        <name>choiceNonCancellable</name>
        <choiceText>Non-Cancellable</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Non-Cancellable</stringValue></value>
    </choices>
    <choices>
        <name>choiceCustom</name>
        <choiceText>Custom Terms</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Custom</stringValue></value>
    </choices>

    <actionCalls>
        <name>submitForApproval</name>
        <label>Submit for Approval</label>
        <locationX>176</locationX>
        <locationY>1010</locationY>
        <actionName>submit</actionName>
        <actionType>submit</actionType>
        <connector>
            <targetReference>screenSuccess</targetReference>
        </connector>
        <faultConnector>
            <targetReference>screenErrorSubmit</targetReference>
        </faultConnector>
        <inputParameters>
            <name>objectId</name>
            <value>
                <elementReference>varContractId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>comments</name>
            <value>
                <stringValue>Contract promoted from approved Opportunity via Promote to Contract flow.</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>processDefinitionNameOrId</name>
            <value>
                <stringValue>Contract_Approval_Process</stringValue>
            </value>
        </inputParameters>
    </actionCalls>

    <decisions>
        <name>decisionIsApproved</name>
        <label>Is Opportunity Approved?</label>
        <locationX>176</locationX>
        <locationY>290</locationY>
        <defaultConnector>
            <targetReference>screenErrorNotApproved</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Approved</defaultConnectorLabel>
        <rules>
            <name>outcomeIsApproved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getOpportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>Approved</stringValue></rightValue>
            </conditions>
            <connector>
                <targetReference>getExistingContract</targetReference>
            </connector>
            <label>Yes - Approved</label>
        </rules>
    </decisions>

    <decisions>
        <name>decisionContractExists</name>
        <label>Active Contract Already Exists?</label>
        <locationX>176</locationX>
        <locationY>530</locationY>
        <defaultConnector>
            <targetReference>screenSignatoryDetails</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No - Proceed</defaultConnectorLabel>
        <rules>
            <name>outcomeContractExists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getExistingContract.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector>
                <targetReference>screenErrorContractExists</targetReference>
            </connector>
            <label>Yes - Block Duplicate</label>
        </rules>
    </decisions>

    <recordLookups>
        <name>getOpportunity</name>
        <label>Get Opportunity</label>
        <locationX>176</locationX>
        <locationY>170</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>decisionIsApproved</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>recordId</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <recordLookups>
        <name>getExistingContract</name>
        <label>Get Existing Active Contract</label>
        <locationX>176</locationX>
        <locationY>410</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>decisionContractExists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>recordId</elementReference></value>
        </filters>
        <filters>
            <field>Contract_Status__c</field>
            <operator>NotEqualTo</operator>
            <value><stringValue>Cancelled</stringValue></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Advertising_Contract__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <screens>
        <name>screenSignatoryDetails</name>
        <label>Step 1 of 2 - Signatory Details</label>
        <locationX>176</locationX>
        <locationY>650</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>screenTermsAndPolicies</targetReference>
        </connector>
        <fields>
            <name>dispHeader</name>
            <fieldText>&lt;h2&gt;Promote to Contract&lt;/h2&gt;&lt;p&gt;Review the opportunity details and enter the authorized signatory.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>dispOppName</name>
            <fieldText>&lt;strong&gt;Opportunity:&lt;/strong&gt; {!getOpportunity.Name}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>dispDates</name>
            <fieldText>&lt;strong&gt;Campaign Dates:&lt;/strong&gt; {!getOpportunity.Start_Date__c} - {!getOpportunity.End_Date__c}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>dispBudget</name>
            <fieldText>&lt;strong&gt;Total Contract Value:&lt;/strong&gt; {!getOpportunity.Total_Budget__c}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>dispMarket</name>
            <fieldText>&lt;strong&gt;Market:&lt;/strong&gt; {!getOpportunity.Market__c}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>inputSignatoryName</name>
            <dataType>String</dataType>
            <fieldText>Signatory Name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>inputSignatoryTitle</name>
            <dataType>String</dataType>
            <fieldText>Signatory Title</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>inputSignatoryEmail</name>
            <dataType>String</dataType>
            <fieldText>Signatory Email</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <nextOrFinishButtonLabel>Next: Contract Terms</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <screens>
        <name>screenTermsAndPolicies</name>
        <label>Step 2 of 2 - Contract Terms</label>
        <locationX>176</locationX>
        <locationY>770</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>createContract</targetReference>
        </connector>
        <fields>
            <name>dispTermsHeader</name>
            <fieldText>&lt;p&gt;Fill in contract terms, cancellation policy, and make-good provisions. Optional fields can be completed later on the contract record.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>inputContractTerms</name>
            <dataType>String</dataType>
            <fieldText>Contract Terms</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>inputCancellationPolicy</name>
            <choiceReferences>choiceStandard30</choiceReferences>
            <choiceReferences>choiceStandard60</choiceReferences>
            <choiceReferences>choiceNonCancellable</choiceReferences>
            <choiceReferences>choiceCustom</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Cancellation Policy</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>inputCancellationNoticeDays</name>
            <dataType>Number</dataType>
            <fieldText>Cancellation Notice Period Days</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <scale>0</scale>
        </fields>
        <fields>
            <name>inputCancellationFeePercent</name>
            <dataType>Number</dataType>
            <fieldText>Cancellation Fee Percent</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <scale>2</scale>
        </fields>
        <fields>
            <name>inputMakeGoodPolicy</name>
            <dataType>String</dataType>
            <fieldText>Make-Good Policy</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>inputMakeGoodCredits</name>
            <dataType>Currency</dataType>
            <fieldText>Make-Good Credits</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <scale>2</scale>
        </fields>
        <fields>
            <name>inputNotes</name>
            <dataType>String</dataType>
            <fieldText>Notes</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <nextOrFinishButtonLabel>Create Contract &amp; Submit for Approval</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <screens>
        <name>screenSuccess</name>
        <label>Contract Created</label>
        <locationX>176</locationX>
        <locationY>1130</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>dispSuccess</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Contract created and submitted for approval.&lt;/strong&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <screens>
        <name>screenErrorNotApproved</name>
        <label>Cannot Promote - Not Approved</label>
        <locationX>440</locationX>
        <locationY>290</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>dispErrorNotApproved</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Cannot Create Contract.&lt;/strong&gt; This opportunity must be Approved first. Current status: {!getOpportunity.StageName}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <screens>
        <name>screenErrorContractExists</name>
        <label>Cannot Promote - Contract Exists</label>
        <locationX>440</locationX>
        <locationY>530</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>dispErrorContractExists</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Contract Already Exists.&lt;/strong&gt; An active contract already exists for this opportunity.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <screens>
        <name>screenErrorCreate</name>
        <label>Error Creating Contract</label>
        <locationX>440</locationX>
        <locationY>890</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>dispErrorCreate</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Error Creating Contract.&lt;/strong&gt; {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <screens>
        <name>screenErrorSubmit</name>
        <label>Contract Created - Approval Submission Failed</label>
        <locationX>440</locationX>
        <locationY>1010</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>dispErrorSubmit</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Contract created, but approval submission failed.&lt;/strong&gt; {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <recordCreates>
        <name>createContract</name>
        <label>Create Contract</label>
        <locationX>176</locationX>
        <locationY>890</locationY>
        <assignRecordIdToReference>varContractId</assignRecordIdToReference>
        <connector>
            <targetReference>submitForApproval</targetReference>
        </connector>
        <faultConnector>
            <targetReference>screenErrorCreate</targetReference>
        </faultConnector>
        <inputAssignments><field>Opportunity__c</field><value><elementReference>recordId</elementReference></value></inputAssignments>
        <inputAssignments><field>Account__c</field><value><elementReference>getOpportunity.AccountId</elementReference></value></inputAssignments>
        <inputAssignments><field>Agency_Account__c</field><value><elementReference>getOpportunity.Agency_Account__c</elementReference></value></inputAssignments>
        <inputAssignments><field>Start_Date__c</field><value><elementReference>getOpportunity.Start_Date__c</elementReference></value></inputAssignments>
        <inputAssignments><field>End_Date__c</field><value><elementReference>getOpportunity.End_Date__c</elementReference></value></inputAssignments>
        <inputAssignments><field>Total_Contract_Value__c</field><value><elementReference>getOpportunity.Total_Budget__c</elementReference></value></inputAssignments>
        <inputAssignments><field>Market__c</field><value><elementReference>getOpportunity.Market__c</elementReference></value></inputAssignments>
        <inputAssignments><field>Contract_Status__c</field><value><stringValue>Draft</stringValue></value></inputAssignments>
        <inputAssignments><field>Signatory_Name__c</field><value><elementReference>inputSignatoryName</elementReference></value></inputAssignments>
        <inputAssignments><field>Signatory_Title__c</field><value><elementReference>inputSignatoryTitle</elementReference></value></inputAssignments>
        <inputAssignments><field>Signatory_Email__c</field><value><elementReference>inputSignatoryEmail</elementReference></value></inputAssignments>
        <inputAssignments><field>Contract_Terms__c</field><value><elementReference>inputContractTerms</elementReference></value></inputAssignments>
        <inputAssignments><field>Cancellation_Policy__c</field><value><elementReference>inputCancellationPolicy</elementReference></value></inputAssignments>
        <inputAssignments><field>Cancellation_Notice_Days__c</field><value><elementReference>inputCancellationNoticeDays</elementReference></value></inputAssignments>
        <inputAssignments><field>Cancellation_Fee_Percent__c</field><value><elementReference>inputCancellationFeePercent</elementReference></value></inputAssignments>
        <inputAssignments><field>Make_Good_Policy__c</field><value><elementReference>inputMakeGoodPolicy</elementReference></value></inputAssignments>
        <inputAssignments><field>Make_Good_Credits__c</field><value><elementReference>inputMakeGoodCredits</elementReference></value></inputAssignments>
        <inputAssignments><field>Notes__c</field><value><elementReference>inputNotes</elementReference></value></inputAssignments>
        <object>Advertising_Contract__c</object>
    </recordCreates>

    <start>
        <locationX>176</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>getOpportunity</targetReference>
        </connector>
    </start>

    <status>Active</status>

    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varContractId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>