<?xml version="1.0" encoding="UTF-8"?>
<FlexiPage xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Sales Operations Console app page. Houses the salesOpsConsole LWC which renders the six-tab layout with KPI header.</description>
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceId>sales_ops_console_main</componentInstanceId>
                <componentName>c:salesOpsConsole</componentName>
            </componentInstance>
        </itemInstances>
        <name>main</name>
        <type>Region</type>
    </flexiPageRegions>
    <masterLabel>Sales Operations Console</masterLabel>
    <template>
        <name>flexipage:defaultAppHomeTemplate</name>
    </template>
    <type>AppPage</type>
</FlexiPage>
